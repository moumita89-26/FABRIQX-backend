DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com,SERVER_PUBLIC_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://developer-beta.com

POSTGRES_DB=fabriqx
POSTGRES_USER=fabriqx
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=true
POSTGRES_SSLMODE=require

MARKETPLACE_ACCESS_KEY=replace-with-provider-public-access-key
MARKETPLACE_WEBHOOK_SECRET=replace-with-a-long-provider-webhook-secret
MARKETPLACE_CHECKOUT_URL=https://payment-provider.example/checkout

FRONTEND_RESET_PASSWORD_URL=https://developer-beta.com/fabriqx/reset-password
INFLUENCER_LOGIN_URL=https://developer-beta.com/fabriqx/influencer/login
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=15
PRODUCT_IMPORT_IMAGE_MAX_BYTES=10485760
PRODUCT_IMPORT_IMAGE_TIMEOUT=15
